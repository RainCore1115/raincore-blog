---
interface Props {
	/** Umami 统计脚本地址，如 https://u.a.07210700.xyz/script.js */
	scriptUrl: string;
	/** data-website-id */
	websiteId: string;
	/** 可选的会话录制脚本地址，如 https://u.a.07210700.xyz/recorder.js */
	recorderUrl?: string;
}

const { scriptUrl, websiteId, recorderUrl } = Astro.props;
---

<!-- Umami 网站统计 -->
<script
	is:inline
	data-swup-ignore-script
	defer
	src={scriptUrl}
	data-website-id={websiteId}></script>
{
	recorderUrl && (
		<script
			is:inline
			data-swup-ignore-script
			define:vars={{ recorderUrl, websiteId }}
		>
			/* 会话录制脚本体积较大（约 57KB）且完全不影响首屏展示，
			   放到 load 之后的空闲时段再加载，避免与首屏关键资源抢带宽和主线程。 */
			(function () {
				function loadRecorder() {
					if (document.querySelector("script[data-umami-recorder]")) return;
					var s = document.createElement("script");
					s.src = recorderUrl;
					s.defer = true;
					s.setAttribute("data-website-id", websiteId);
					s.setAttribute("data-umami-recorder", "true");
					document.head.appendChild(s);
				}
				function schedule() {
					if ("requestIdleCallback" in window) {
						requestIdleCallback(loadRecorder, { timeout: 4000 });
					} else {
						setTimeout(loadRecorder, 2000);
					}
				}
				if (document.readyState === "complete") schedule();
				else window.addEventListener("load", schedule, { once: true });
			})();
		</script>
	)
}
